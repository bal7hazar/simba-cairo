#!/usr/bin/env bash
# Runs scripts/prepush.sh and blocks the push on failure. Enable with: git config core.hooksPath .githooks
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. Deletion lines are skipped
# (a push of only deletions needs no check). The base the changes are compared against is the remote sha of
# the single pushed ref when it exists locally; when several refs are pushed, or the remote sha is unknown
# (a new branch), it is origin/main (the most conservative base: the widest set of changes is checked).
# The checks run on the working tree, so the hook refuses to run when it is not what is pushed: a pushed
# sha other than HEAD, tracked files that differ from HEAD, or untracked files that a build or a check reads
# (the build compiles them, CI does not have them: crates/, tests/, benchmarks/, tools/, scripts/, gas/, any
# Scarb.toml or Scarb.lock, .tool-versions; ignored files are not listed and stay allowed). A tag is compared
# by the commit it points at (an annotated tag has its own object sha); a tag whose commit is not HEAD is
# skipped with a message only when that commit is already on origin/main (a release tag points at an
# already-checked commit), and refused otherwise.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
base=origin/main
refs=0
while read -r _ local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue # a deletion
    peeled=$(git rev-parse --verify --quiet "$local_sha^{commit}" || echo "$local_sha") # a tag of a tree or blob stays as is
    if [[ "$remote_ref" == refs/tags/* && "$peeled" != "$head" ]]; then
        if git merge-base --is-ancestor "$peeled" origin/main 2> /dev/null; then
            echo "pre-push: $remote_ref points at $peeled, already on origin/main: working-tree checks skipped for this tag" >&2
            continue
        fi
        echo "pre-push: refusing: $remote_ref points at $peeled, which is neither HEAD nor on origin/main (git fetch origin main?). Check out and push the commit first." >&2
        exit 1
    fi
    refs=$((refs + 1))
    if [[ "$peeled" != "$head" ]]; then
        echo "pre-push: refusing: pushing $local_sha but HEAD is $head; the checks run on the working tree. Check out the branch you push." >&2
        exit 1
    fi
    if [[ "$refs" -eq 1 && "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        base=$remote_sha
    else
        base=origin/main
    fi
done
[[ "$refs" -eq 0 ]] && exit 0 # only deletions or skipped tags
if ! git diff --quiet HEAD; then
    echo "pre-push: refusing: tracked files differ from HEAD; commit or stash, then push." >&2
    exit 1
fi
status=$(git --no-optional-locks status --porcelain --untracked-files=all) || {
    echo "pre-push: refusing: git status failed, cannot tell whether untracked files are left." >&2
    exit 1
}
untracked=$(sed -n 's/^?? //p' <<< "$status" \
    | grep -E '^"?(crates/|tests/|benchmarks/|tools/|scripts/|gas/|\.tool-versions"?$|(.*/)?Scarb\.(toml|lock)"?$)' || true)
if [[ -n "$untracked" ]]; then
    echo "pre-push: refusing: untracked files that a build or a check reads (the build compiles them, CI will not have them):" >&2
    sed 's/^/  /' <<< "$untracked" >&2
    echo "pre-push: add or remove them, then push." >&2
    exit 1
fi
exec scripts/prepush.sh "$base"
